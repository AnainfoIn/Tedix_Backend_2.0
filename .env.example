# Used by docker-compose.yml. Copy to .env and change the values. Never commit .env.

# Postgres
DB_USER=tedix
DB_PASSWORD=change-me
DB_NAME=tedix_development
# Port the database listens on, on your machine
DB_PORT=5432
# 127.0.0.1 = only this machine can connect. Use 0.0.0.0 to open it to the network
# (then use a strong password and a firewall).
DB_BIND=127.0.0.1

# API + admin panel port on your machine
API_PORT=4000
# Long random string, e.g. `openssl rand -hex 32`
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=

# Optional: first admin user, created when the database is initialised for the first time
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: source database for scripts/clone-rails-db.sh
# SOURCE_DATABASE_URL=postgresql://user:password@host:5432/tedix_backend
