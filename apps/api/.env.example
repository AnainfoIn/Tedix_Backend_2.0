# Same Postgres database the Rails app uses (or a copy of it for development).
DATABASE_URL=postgresql://tedix:tedix@localhost:5432/tedix_development
PORT=4000
NODE_ENV=development

# Secret for admin panel JWTs (separate from the app's SECRET_KEY_BASE). Use a long random value.
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
# Admin session length in hours
ADMIN_JWT_TTL_HOURS=12

# Comma-separated list of origins allowed to call the API (the admin panel URL)
CORS_ORIGINS=http://localhost:5173

# Issuer name shown in Google Authenticator for admin 2FA
ADMIN_2FA_ISSUER=Tedix Admin
